[TEMPLATE]
# ═══════════════════════════════════════════════════════════
# Margdarshak — Environment Variables
# Copy this file to .env.local and fill in your values.
# ═══════════════════════════════════════════════════════════


# ─── Site URL (Required for Auth) ─────────────────────────
# IMPORTANT: Must match your deployed URL exactly (no trailing slash)
# Local:      http://localhost:3000
# Vercel:     https://your-app.vercel.app
# Custom:     https://margdarshak.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase Google OAuth Setup ──────────────────────────
# In Supabase Dashboard → Authentication → Providers → Google:
#   1. Enable Google provider
#   2. Add your Google Client ID and Client Secret
#   3. Add redirect URI: YOUR_SITE_URL/auth/callback
#
# In Google Cloud Console → Credentials → OAuth 2.0:
#   1. Add authorized redirect URI: YOUR_SITE_URL/auth/callback
#   2. For localhost: http://localhost:3000/auth/callback

# ─── Supabase Phone OTP Setup ─────────────────────────────
# In Supabase Dashboard → Authentication → Providers → Phone:
#   1. Enable Phone provider
#   2. Configure Twilio or your SMS provider
#   3. Set up OTP template


# Supabase Connection Keys (From https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini API Key (From https://aistudio.google.com/)
GEMINI_API_KEY=

# Google CSE (For Crawler Live Search)
GOOGLE_CSE_ID=
GOOGLE_SEARCH_API_KEY=

# Resend Email Integration (From https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Margdarshak<onboarding@resend.dev>
CRON_SECRET=margdarshak_cron_secret_token
